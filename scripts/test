./scripts/test-nvim --headless '+luafile tests/nvim/stage2_spec.lua'
./scripts/test-nvim --headless '+luafile tests/nvim/lsp_integration_spec.lua'
./scripts/test-nvim --headless '+luafile tests/nvim/stage3_spec.lua'
./scripts/test-nvim --headless '+luafile tests/nvim/stage4_spec.lua'
./scripts/test-nvim --headless '+luafile tests/nvim/stage5_spec.lua'
./scripts/test-nvim --headless '+luafile tests/nvim/stage6_spec.lua'
./scripts/test-nvim --headless '+luafile tests/nvim/kernel_integration_spec.lua'
